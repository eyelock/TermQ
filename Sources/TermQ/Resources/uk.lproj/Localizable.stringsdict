<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>stacks.merge.stack.message %ld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Зіллє %ld пул-реквест у базову гілку.</string>
			<key>few</key>
			<string>Зіллє %ld пул-реквести у базову гілку.</string>
			<key>other</key>
			<string>Зіллє %ld пул-реквестів у базову гілку.</string>
		</dict>
	</dict>
	<key>stacks.link.stack.confirm %ld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Зв'язати %ld гілку</string>
			<key>few</key>
			<string>Зв'язати %ld гілки</string>
			<key>other</key>
			<string>Зв'язати %ld гілок</string>
		</dict>
	</dict>
	<key>stacks.checkout.stack %ld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Отримати весь стек (%ld гілка)</string>
			<key>few</key>
			<string>Отримати весь стек (%ld гілки)</string>
			<key>other</key>
			<string>Отримати весь стек (%ld гілок)</string>
		</dict>
	</dict>
</dict>
</plist>
