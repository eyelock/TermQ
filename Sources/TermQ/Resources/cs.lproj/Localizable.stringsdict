<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>stacks.merge.stack.message %ld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Sloučí %ld pull request do základní větve.</string>
			<key>few</key>
			<string>Sloučí %ld pull requesty do základní větve.</string>
			<key>other</key>
			<string>Sloučí %ld pull requestů do základní větve.</string>
		</dict>
	</dict>
	<key>stacks.link.stack.will.create %ld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Vytvoří %ld nový pull request na GitHubu.</string>
			<key>few</key>
			<string>Vytvoří %ld nové pull requesty na GitHubu.</string>
			<key>other</key>
			<string>Vytvoří %ld nových pull requestů na GitHubu.</string>
		</dict>
	</dict>
	<key>stacks.link.stack.confirm %ld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Propojit %ld větev</string>
			<key>few</key>
			<string>Propojit %ld větve</string>
			<key>other</key>
			<string>Propojit %ld větví</string>
		</dict>
	</dict>
	<key>stacks.checkout.stack %ld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Načíst celý zásobník (%ld větev)</string>
			<key>few</key>
			<string>Načíst celý zásobník (%ld větve)</string>
			<key>other</key>
			<string>Načíst celý zásobník (%ld větví)</string>
		</dict>
	</dict>
	<key>stacks.checkout.stack.done %ld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Načtena %ld větev zásobníku.</string>
			<key>few</key>
			<string>Načteny %ld větve zásobníku.</string>
			<key>other</key>
			<string>Načteno %ld větví zásobníku.</string>
		</dict>
	</dict>
</dict>
</plist>
