<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>stacks.merge.stack.message %ld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Îmbină %ld pull request în ramura de bază.</string>
			<key>few</key>
			<string>Îmbină %ld pull request-uri în ramura de bază.</string>
			<key>other</key>
			<string>Îmbină %ld de pull request-uri în ramura de bază.</string>
		</dict>
	</dict>
	<key>stacks.merge.stack.confirm %ld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Îmbină %ld PR</string>
			<key>few</key>
			<string>Îmbină %ld PR-uri</string>
			<key>other</key>
			<string>Îmbină %ld de PR-uri</string>
		</dict>
	</dict>
	<key>stacks.link.stack.will.create %ld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Creează %ld pull request nou pe GitHub.</string>
			<key>few</key>
			<string>Creează %ld pull request-uri noi pe GitHub.</string>
			<key>other</key>
			<string>Creează %ld de pull request-uri noi pe GitHub.</string>
		</dict>
	</dict>
	<key>stacks.link.stack.confirm %ld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Leagă %ld ramură</string>
			<key>few</key>
			<string>Leagă %ld ramuri</string>
			<key>other</key>
			<string>Leagă %ld de ramuri</string>
		</dict>
	</dict>
	<key>stacks.checkout.stack %ld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Extrage toată stiva (%ld ramură)</string>
			<key>few</key>
			<string>Extrage toată stiva (%ld ramuri)</string>
			<key>other</key>
			<string>Extrage toată stiva (%ld de ramuri)</string>
		</dict>
	</dict>
	<key>stacks.checkout.stack.done %ld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>S-a extras %ld ramură din stivă.</string>
			<key>few</key>
			<string>S-au extras %ld ramuri din stivă.</string>
			<key>other</key>
			<string>S-au extras %ld de ramuri din stivă.</string>
		</dict>
	</dict>
</dict>
</plist>
